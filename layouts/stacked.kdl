layout {
    tab hide_floating_panes=true {
        floating_panes {
            zide_rename
        }
        pane stacked=true {
            filepicker name="picker"
            editor expanded=true
        }
        compact_bar size=1
    }

    // TEMPLATES
    pane_template name="filepicker" {
        command "${ZIDE_DIR}/bin/zide-pick"
    }

    pane_template name="editor" {
        command "$EDITOR"
    }

    pane_template name="compact_bar" borderless=true {
        plugin location="compact-bar"
    }

    pane_template name="zide_rename" close_on_exit=true{
        command "${ZIDE_DIR}/bin/zide-rename"
    }

    new_tab_template {
        pane
        compact_bar size=1
    }
}
