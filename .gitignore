!layouts/compact.kdl
!layouts/compact_git.kdl
!layouts/default.kdl
!layouts/default_git.kdl
!layouts/stacked.kdl
!layouts/stacked_git.kdl
!layouts/tall.kdl
!layouts/tall_git.kdl
!layouts/wide.kdl
!layouts/wide_git.kdl
tmp/
